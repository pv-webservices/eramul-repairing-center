---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import {videos} from '../data/videos';
const photos=[
 {image:'field-9',w:825,h:1100,category:'Air Conditioning',caption:'Outdoor cooling equipment',alt:'Outdoor cooling units and service area from client-supplied media'},
 {image:'field-10',w:825,h:1100,category:'Refrigeration',caption:'Refrigeration pipework & components',alt:'Open refrigeration system showing pipework and components'},
 {image:'field-11',w:825,h:1100,category:'Air Conditioning',caption:'Air conditioning installation setting',alt:'Client-supplied rooftop photograph of air conditioning equipment'},
 {image:'field-12',w:619,h:1100,category:'Industrial Equipment',caption:'Inside the equipment service area',alt:'Machinery components and open panels in a client-supplied service photograph'},
 {image:'field-14',w:825,h:1100,category:'Refrigeration',caption:'A closer look at cooling systems',alt:'Cooling equipment with service panels open'},
 {image:'field-15',w:619,h:1100,category:'Refrigeration',caption:'Pressure gauge equipment',alt:'Close-up of refrigeration pressure gauge equipment'},
 {image:'field-16',w:495,h:1100,category:'Industrial Equipment',caption:'Industrial equipment details',alt:'Industrial equipment pipework from supplied repair media'},
 {image:'gen/industrial-chiller-900',w:900,h:600,category:'Illustrative Images',caption:'Industrial chiller service illustration',alt:'AI-generated illustration of a technician at an industrial chiller'},
 {image:'about-small',w:800,h:533,category:'Illustrative Images',caption:'Washing machine service illustration',alt:'AI-generated illustrative technician inspecting a washing machine'},
];
const filters=['All Photos','Air Conditioning','Refrigeration','Industrial Equipment','Illustrative Images'];
---
<Layout title="Repair Photos & Machinery Videos" description="Browse client-supplied repair photographs and nine machinery videos from Ekramul All Repairing Service Center, with separately labelled illustrative service images.">
<PageHero crumb="Gallery" title="A closer look at <em>the machinery.</em>" eyebrow="Photos & videos" description="Explore the repair photographs and videos supplied by the business, alongside clearly labelled service illustrations. Captions describe visible equipment without making unverified project claims."/>
<section class="section"><div class="wrap"><div class="filter-bar" role="group" aria-label="Filter gallery photos">{filters.map((category,i)=><button class="chip" data-photo-filter={category} aria-pressed={i===0?'true':'false'}>{category}</button>)}</div><p class="filter-status" role="status">Showing all 9 photos</p><div class="gallery-grid">{photos.map((photo,i)=><figure class="gallery-card" data-photo-category={photo.category}><button class="gallery-open" data-index={i} aria-label={`Enlarge: ${photo.caption}`}><img src={`/images/${photo.image}.webp`} width={photo.w} height={photo.h} loading="lazy" alt={photo.alt}/><span class="zoom-indicator"><Icon name="search" size={18}/></span></button><figcaption>{photo.caption}<small>{photo.category==='Illustrative Images'?'AI-generated illustration':'Client-supplied repair photograph'}</small></figcaption></figure>)}</div></div></section>
<section class="section field" id="videos"><div class="wrap"><div class="section-head section-head--split section-head--light"><div><span class="eyebrow eyebrow--light">From the supplied media</span><h2>Repairing, <em>in motion.</em></h2></div><p>Nine client-supplied equipment videos. Playback starts only when you press play.</p></div><div class="video-grid">{videos.map((video,i)=><figure class="video-card"><video controls playsinline preload="none" poster={`/images/video-${i+1}.webp`} aria-label={`Client-supplied repair video ${i+1}: ${video.title}`}><source src={`/repairing%20video-${i+1}.mp4`} type="video/mp4"/><track kind="captions" src={`/captions/video-${i+1}-hi.vtt`} srclang="hi" label="Hindi · auto captions"/><p>Your browser cannot play this video. <a href={`/repairing%20video-${i+1}.mp4`}>Open video {i+1}</a>.</p></video><figcaption>{video.title}<p class="media-caption">Client-supplied footage · <a href={`/video-transcripts/#video-${i+1}`}>Video description</a></p></figcaption></figure>)}</div></div></section><CTA/>
<dialog class="lightbox" aria-label="Gallery image viewer"><div class="lightbox-top"><p class="lightbox-caption"></p><button class="lightbox-close" aria-label="Close image viewer"><Icon name="close" size={20}/></button></div><img class="lightbox-image" src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt=""/><div class="lightbox-bottom"><button class="lightbox-prev" aria-label="Previous image">←</button><span class="lightbox-count" aria-live="polite"></span><button class="lightbox-next" aria-label="Next image">→</button></div></dialog>
</Layout>
<script>
const dialog=document.querySelector<HTMLDialogElement>('.lightbox');const image=document.querySelector<HTMLImageElement>('.lightbox-image');const caption=document.querySelector('.lightbox-caption');const count=document.querySelector('.lightbox-count');let index=0;let opener:HTMLElement|null=null;
function visiblePhotos(){return Array.from(document.querySelectorAll<HTMLElement>('.gallery-card')).filter(card=>!card.hidden);}
function showImage(next:number){const cards=visiblePhotos();index=(next+cards.length)%cards.length;const source=cards[index].querySelector('img');if(image&&source){image.src=source.src;image.alt=source.alt;}if(caption)caption.textContent=cards[index].querySelector('figcaption')?.firstChild?.textContent||'';if(count)count.textContent=`${index+1} / ${cards.length}`;}
document.querySelectorAll<HTMLButtonElement>('.gallery-open').forEach(button=>button.addEventListener('click',()=>{opener=button;const card=button.closest<HTMLElement>('.gallery-card');showImage(visiblePhotos().indexOf(card!));dialog?.showModal();}));
document.querySelector('.lightbox-close')?.addEventListener('click',()=>dialog?.close());dialog?.addEventListener('close',()=>opener?.focus());dialog?.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();}});document.querySelector('.lightbox-next')?.addEventListener('click',()=>showImage(index+1));document.querySelector('.lightbox-prev')?.addEventListener('click',()=>showImage(index-1));dialog?.addEventListener('keydown',event=>{if(event.key==='ArrowRight'){event.preventDefault();showImage(index+1);}if(event.key==='ArrowLeft'){event.preventDefault();showImage(index-1);}});
document.querySelectorAll<HTMLButtonElement>('[data-photo-filter]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-photo-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));const selected=button.dataset.photoFilter;document.querySelectorAll<HTMLElement>('.gallery-card').forEach(card=>card.hidden=selected!=='All Photos'&&card.dataset.photoCategory!==selected);const status=document.querySelector('.filter-status');if(status)status.textContent=`Showing ${visiblePhotos().length} photos`;}));
</script>
