---
import {business,mapUrl,whatsappUrl} from '../data/business';
import {services} from '../data/services';
import Icon from './Icon.astro';
---
<section class="contact" id="enquiry"><div class="wrap contact-grid">
  <div class="contact-info reveal">
    <span class="eyebrow eyebrow--light">Get in touch</span>
    <h2>Need a repair?<br/><em>Let’s talk today.</em></h2>
    <p>Tell us what needs attention. We’ll discuss your equipment and the next step.</p>
    <ul class="contact-list">
      <li><span class="contact-icon"><Icon name="phone" size={20}/></span><div><span class="small-label">Call the service center</span><a href={`tel:${business.phone}`}>{business.phoneDisplay}</a><a href={`tel:${business.secondary}`}>{business.secondaryDisplay}</a></div></li>
      <li><span class="contact-icon contact-icon--wa"><Icon name="whatsapp" size={20}/></span><div><span class="small-label">WhatsApp</span><a href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Chat on {business.phoneDisplay}</a></div></li>
      <li><span class="contact-icon"><Icon name="mail" size={20}/></span><div><span class="small-label">Send an email</span><a class="email-link" href={`mailto:${business.email}`}>{business.email}</a></div></li>
      <li><span class="contact-icon"><Icon name="pin" size={20}/></span><div><span class="small-label">Visit the center</span><a href={mapUrl} target="_blank" rel="noopener noreferrer">{business.address}</a><a class="map-link" href={mapUrl} target="_blank" rel="noopener noreferrer">Open in Google Maps <Icon name="arrow" size={15}/></a></div></li>
    </ul>
  </div>
  <div class="enquiry-form reveal"><h3>Send us a message</h3><p>A little detail helps us understand the problem.</p>
    <form action={`https://formsubmit.co/${business.email}`} method="POST">
      <input type="hidden" name="_subject" value="New machinery repair website enquiry"/>
      <input type="hidden" name="_template" value="table"/>
      <input type="hidden" name="_next" value={`${business.origin}/thank-you/`}/>
      <div class="honey" aria-hidden="true"><label>Leave this field blank<input type="text" name="_honey" tabindex="-1" autocomplete="off"/></label></div>
      <div class="form-row"><label>Full name<input name="name" required minlength="2" maxlength="100" autocomplete="name" placeholder="Your name"/></label><label>Mobile number<input name="phone" type="tel" required pattern="[+]?[0-9][0-9 ]{8,16}[0-9]" title="Enter your phone number using digits, optional spaces and an optional leading +" autocomplete="tel" maxlength="18" placeholder="Your mobile number"/></label></div>
      <label>Email address<input name="email" type="email" required autocomplete="email" maxlength="150" placeholder="you@example.com"/></label>
      <label>Service required<select name="service" required><option value="">Select your equipment</option>{services.map(s=><option value={s.name} data-slug={s.slug}>{s.name}</option>)}<option>Other machinery enquiry</option></select></label>
      <label>Describe the problem<textarea name="message" required minlength="10" maxlength="3000" rows="4" placeholder="Equipment type, model and what’s going wrong…"></textarea></label>
      <p class="form-notice">Your enquiry is processed by FormSubmit. By submitting, you agree to our <a href="/privacy-policy/">privacy policy</a>.</p>
      <button class="btn btn--primary btn--block" type="submit">Submit Enquiry <Icon name="arrow" size={18}/></button><p class="submit-status" role="status"></p>
    </form>
  </div>
</div></section>
