---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import {business,mapUrl,whatsappUrl} from '../data/business';
import {services,categories} from '../data/services';
interface Props {title:string;description:string;noindex?:boolean;ogImage?:string;}
const {title,description,noindex=false,ogImage='/images/gen/hero-rooftop-vrv.webp'}=Astro.props;
const path=Astro.url.pathname;
const canonical=new URL(path,business.origin).href;
const nav=[['Home','/'],['Services','/services/'],['About Us','/about-us/'],['Why Choose Us','/why-choose-us/'],['Gallery','/gallery/'],['FAQs','/faqs/'],['Contact','/contact-us/']];
const groups=categories.filter(c=>c!=='All Services').map(c=>({name:c,items:services.filter(s=>s.category===c)}));
const isActive=(href:string)=>href==='/'?path==='/':path.startsWith(href);
const schema={'@context':'https://schema.org','@type':'LocalBusiness','@id':`${business.origin}/#business`,name:business.name,url:business.origin,email:business.email,telephone:[business.phone,business.secondary],image:`${business.origin}/website%20logo.webp`,address:{'@type':'PostalAddress',streetAddress:'Shop No. 3, Gali No. 5, Hoshiyarpur, Sector 51',addressLocality:'Noida',addressRegion:'Uttar Pradesh',addressCountry:'IN'}};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#061a3a"/><title>{title} | Ekramul All Repairing Service Center</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={`${business.origin}${ogImage}`}/><meta property="og:site_name" content={business.name}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" type="image/png" href="/favicon.png"/><script type="application/ld+json" set:html={JSON.stringify(schema)}/>
<script is:inline>document.documentElement.classList.add('js');</script>
</head><body>
<div class="loader" aria-hidden="true"><span class="loader-bar"></span></div>
<a class="skip-link" href="#main">Skip to content</a>

<div class="topbar"><div class="wrap topbar-inner">
  <div class="topbar-links">
    <a href={`tel:${business.phone}`}><Icon name="phone" size={14}/>{business.phoneDisplay}</a>
    <a href={`tel:${business.secondary}`} class="hide-sm"><Icon name="phone" size={14}/>{business.secondaryDisplay}</a>
    <a href={`mailto:${business.email}`} class="hide-md"><Icon name="mail" size={14}/>{business.email}</a>
  </div>
  <div class="topbar-links">
    <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="hide-lg"><Icon name="pin" size={14}/>Hoshiyarpur, Noida Sector 51</a>
    <a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" class="topbar-wa"><Icon name="whatsapp" size={14}/>WhatsApp us</a>
  </div>
</div></div>

<header class="site-header"><div class="wrap header-inner">
  <a href="/" class="logo" aria-label="Ekramul All Repairing Service Center home"><img src="/website%20logo.webp" width="240" height="80" alt="Ekramul All Repairing Service Center"/></a>
  <nav class="main-nav" id="main-nav" aria-label="Main navigation">
    {nav.map(([label,href])=>href==='/services/'
      ? <div class="nav-services"><a href={href} class:list={['nav-link',{active:isActive(href)}]} aria-current={path===href?'page':undefined}>{label}</a><button class="services-toggle" aria-expanded="false" aria-controls="mega" aria-label="Show all services"><Icon name="down" size={16}/></button>
          <div class="mega" id="mega" hidden><div class="mega-grid">{groups.map(g=><div class="mega-col"><span class="mega-title">{g.name}</span>{g.items.map(s=><a href={`/services/${s.slug}/`}><img src={`/images/${s.image}.webp`} width="48" height="36" alt="" loading="lazy"/>{s.short}</a>)}</div>)}
          <a class="mega-cta" href="/services/"><span>View all 12 services</span><Icon name="arrow" size={18}/></a></div></div></div>
      : <a href={href} class:list={['nav-link',{active:isActive(href)}]} aria-current={path===href?'page':undefined}>{label}</a>)}
    <div class="nav-mobile-extra"><a class="btn btn--primary" href="/contact-us/#enquiry">Book a Service <Icon name="arrow" size={18}/></a><a class="btn btn--wa" href={whatsappUrl()} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={18}/>WhatsApp</a></div>
  </nav>
  <div class="header-actions">
    <a class="header-call" href={`tel:${business.phone}`}><span class="call-dot"><Icon name="phone" size={18}/></span><span><small>Call the center</small><strong>{business.phoneDisplay}</strong></span></a>
    <a class="btn btn--primary btn--sm hide-md" href="/contact-us/#enquiry">Book a Service</a>
    <button class="menu-toggle" aria-controls="main-nav" aria-expanded="false" aria-label="Open navigation"><span></span><span></span><span></span></button>
  </div>
</div></header>

<main id="main"><slot/></main>

<footer class="site-footer">
  <div class="wrap footer-top">
    <div><span class="eyebrow eyebrow--light">Talk to the service center</span><p class="footer-cta-title">Something not running right?<br/><em>Let’s discuss it today.</em></p></div>
    <div class="footer-cta-actions"><a class="btn btn--primary" href={`tel:${business.phone}`}><Icon name="phone" size={18}/>Call {business.phoneDisplay}</a><a class="btn btn--wa" href={whatsappUrl()} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={18}/>WhatsApp</a></div>
  </div>
  <div class="wrap footer-grid">
    <div class="footer-brand"><a href="/" class="footer-logo" aria-label="Home"><img src="/website%20logo.webp" width="240" height="80" loading="lazy" alt={business.name}/></a><p>Repairing and maintenance enquiries for home, commercial and industrial equipment — from washing machines to industrial chillers.</p><span class="footer-location"><Icon name="pin" size={15}/>Hoshiyarpur · Sector 51 · Noida</span></div>
    <div><h2>Company</h2>{[['About Us','/about-us/'],['Why Choose Us','/why-choose-us/'],['Gallery','/gallery/'],['FAQs','/faqs/'],['Contact Us','/contact-us/']].map(([label,url])=><a href={url}>{label}</a>)}</div>
    <div><h2>Services</h2>{[services[0],services[2],services[8],services[5],services[10],services[1]].map(s=><a href={`/services/${s.slug}/`}>{s.short}</a>)}<a href="/services/" class="footer-more">All 12 services →</a></div>
    <div class="footer-contact"><h2>Contact</h2><a href={`tel:${business.phone}`}><Icon name="phone" size={16}/>{business.phoneDisplay}</a><a href={`tel:${business.secondary}`}><Icon name="phone" size={16}/>{business.secondaryDisplay}</a><a href={`mailto:${business.email}`}><Icon name="mail" size={16}/>{business.email}</a><a href={mapUrl} target="_blank" rel="noopener noreferrer"><Icon name="pin" size={16}/>{business.address}</a></div>
  </div>
  <div class="wrap footer-bottom"><span>© {new Date().getFullYear()} {business.name}. All rights reserved.</span><div><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-and-conditions/">Terms & Conditions</a></div></div>
</footer>

<div class="float-actions" aria-label="Quick contact">
  <a class="float-btn float-btn--wa" href={whatsappUrl()} target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp"><Icon name="whatsapp" size={26}/><span class="float-label">WhatsApp</span></a>
  <a class="float-btn float-btn--call" href={`tel:${business.phone}`} aria-label={`Call ${business.phoneDisplay}`}><Icon name="phone" size={22}/><span class="float-label">Call now</span></a>
</div>

<script>
const root=document.documentElement;
const done=()=>root.classList.add('is-loaded');
if(document.readyState==='complete')done();else{window.addEventListener('load',done);window.setTimeout(done,1200);}

const header=document.querySelector('.site-header');
const onScroll=()=>header?.classList.toggle('is-scrolled',window.scrollY>40);onScroll();window.addEventListener('scroll',onScroll,{passive:true});

const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector<HTMLElement>('.main-nav');
function placeDrawer(){if(header)root.style.setProperty('--nav-top',`${Math.max(0,header.getBoundingClientRect().bottom)}px`);}
window.addEventListener('resize',()=>{if(nav?.classList.contains('is-open'))placeDrawer();});
function setMenu(open:boolean){if(open)placeDrawer();menu?.setAttribute('aria-expanded',String(open));menu?.setAttribute('aria-label',open?'Close navigation':'Open navigation');nav?.classList.toggle('is-open',open);document.body.classList.toggle('menu-open',open);}
menu?.addEventListener('click',()=>setMenu(menu.getAttribute('aria-expanded')!=='true'));

const dropButton=document.querySelector<HTMLButtonElement>('.services-toggle');const drop=document.querySelector<HTMLElement>('.mega');const navServices=document.querySelector<HTMLElement>('.nav-services');
function setDrop(open:boolean){dropButton?.setAttribute('aria-expanded',String(open));if(drop)drop.hidden=!open;navServices?.classList.toggle('is-open',open);}
dropButton?.addEventListener('click',()=>setDrop(dropButton.getAttribute('aria-expanded')!=='true'));
const hoverable=window.matchMedia('(hover:hover) and (min-width:1101px)');let hoverTimer=0;
navServices?.addEventListener('mouseenter',()=>{if(hoverable.matches){window.clearTimeout(hoverTimer);setDrop(true);}});
navServices?.addEventListener('mouseleave',()=>{if(hoverable.matches)hoverTimer=window.setTimeout(()=>setDrop(false),180);});
document.addEventListener('click',e=>{if(!(e.target instanceof Element)||!e.target.closest('.nav-services'))setDrop(false);});
document.addEventListener('keydown',e=>{if(e.key!=='Escape')return;if(drop&&!drop.hidden){setDrop(false);dropButton?.focus();}else if(menu?.getAttribute('aria-expanded')==='true'){setMenu(false);menu.focus();}});

const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target);}}),{threshold:.12,rootMargin:'0px 0px -40px 0px'});
document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));

document.querySelectorAll<HTMLFormElement>('.enquiry-form form').forEach(form=>{form.addEventListener('submit',()=>{const button=form.querySelector<HTMLButtonElement>('button[type="submit"]');const status=form.querySelector<HTMLElement>('.submit-status');if(button){button.disabled=true;button.dataset.label=button.innerHTML;button.textContent='Continuing to verification…';}if(status)status.textContent='Opening FormSubmit for verification. If the page does not open, please call us.';window.setTimeout(()=>{if(button){button.disabled=false;button.innerHTML=button.dataset.label||'Submit Enquiry';}},12000);});});
</script>
</body></html>
